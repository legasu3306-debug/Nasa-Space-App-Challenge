# ============================================================================
# FieldShift Ethiopia — Production & Local Environment Variables
# ============================================================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection (Prisma ORM)
DATABASE_URL="postgresql://fieldshift:fieldshift_pw@localhost:5432/fieldshift_ethiopia?schema=public"

# Live NASA Earth Observation APIs (Keyless Public Endpoints)
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal"
NASA_CMR_SEARCH_URL="https://cmr.earthdata.nasa.gov/search"
NASA_ORNL_MODIS_URL="https://modis.ornl.gov/rst/api/v1"
NASA_GIBS_WMTS_URL="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best"

# Optional NASA Earthdata Bearer Token (For authenticated GES DISC / NSIDC HDF5/NetCDF granule downloads)
NASA_EARTHDATA_TOKEN=""

# ESA / ECMWF Copernicus ERA5 Reanalysis (Space Agency Partner Resource)
ERA5_CDS_API_URL="https://cds.climate.copernicus.eu/api/v2"
ERA5_CDS_API_KEY=""

# NASA GLDAS / NLDAS Land Data Assimilation System (NASA Resource)
NLDAS_GLDAS_BASE_URL="https://hydro1.gesdisc.eosdis.nasa.gov/daac-bin/access/"

# Timeouts & Cache Control
EXTERNAL_API_TIMEOUT_MS=15000
TELEMETRY_CACHE_TTL_MINUTES=60

# Google Maps JavaScript API (for interactive farm location map)
VITE_GOOGLE_MAPS_API_KEY=""
